# Copy to .env and fill in. Lessons read these with env("NAME").

# Google Cloud project for the optional GPU VM runs (lessons 20, 21, 27). Leave unset to use recorded results.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Zone with L4 quota for the optional GPU VM (for example, a zone your project can use).
GCP_GPU_ZONE=your-gpu-zone

# Bucket for saving GPU results from the optional VM runs.
GCS_RESULTS_BUCKET=your-results-bucket

# Address of the local serving endpoint (lab value: the Compose cluster or a local vLLM server).
VLLM_BASE_URL=http://localhost:8000/v1

# Key for an OpenAI-compatible server started with --api-key (lessons 15, 16). Leave unset for a local server without a key.
VLLM_API_KEY=your-vllm-api-key
